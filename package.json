{
  "name": "@vallahrich/stickman-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic stick-figure animation and local MCP tools for IT presentations, digital-service explainers, websites and video",
  "keywords": ["stickman", "stick-figure", "animation", "mcp", "presentation", "svg", "digital-services", "copilot", "claude-code", "codex"],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "stickman": "./dist/cli.js",
    "stickman-mcp": "./dist/mcp.js"
  },
  "exports": {
    "./room": {
      "types": "./dist/room.d.ts",
      "import": "./dist/room.js"
    },
    "./keyboard": {
      "types": "./dist/keyboard.d.ts",
      "import": "./dist/keyboard.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "mcp": "node dist/mcp.js",
    "preview:deck": "npm run build && node scripts/preview-deck.mjs",
    "motions:build": "node scripts/motions/build.mjs",
    "motions:check": "node scripts/motions/quality.mjs",
    "motions:assemble": "node scripts/motions/assemble.mjs",
    "motions:shots": "node scripts/motions/shots.mjs",
    "motions:demo": "node scripts/motions/presentation-demo.mjs",
    "site:build": "npm run -s build && node scripts/site/build.mjs",
    "site:dev": "npm run -s build && node scripts/site/build.mjs --dev",
    "site:serve": "node scripts/site/serve.mjs",
    "site:showcase": "npm run -s build && node --expose-gc scripts/site/build-showcase.mjs",
    "site:test": "playwright test --config playwright.site.config.mjs",
    "motions:joins": "npm run -s build && node scripts/motions/joins.mjs",
    "motions:poses": "node scripts/motions/poses.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "ffmpeg-static": "^5.3.0"
  }
}
